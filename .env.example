HOST=0.0.0.0
PORT=4000
DATA_DIR=server/data
PUBLIC_BASE_URL=http://192.168.1.14:3000
# Comma-separated browser origins allowed to call the API. Required for multi-origin production deployments.
CORS_ORIGINS=https://cheapvpn.example.com
TRUST_PROXY=false
ADMIN_PASSWORD=change-me-now
ADMIN_ENCRYPTION_KEY=replace-with-a-long-random-secret
PAYMENT_WEBHOOK_SECRET=replace-with-payment-webhook-secret
PAYMENT_MODE=mock
ALLOW_DEMO_SUBSCRIPTION=false
ALLOW_DEMO_ACCOUNT=false
# Optional hosted checkout URL. Supports {orderId} and {amount} placeholders.
PAYMENT_CHECKOUT_URL_TEMPLATE=
# Shown to customers only when PAYMENT_MODE=manual; do not put secrets here.
PAYMENT_MANUAL_INSTRUCTIONS=
UPSTREAM_SUBSCRIPTION_URL=
UPSTREAM_USAGE_API_URL=
UPSTREAM_USAGE_API_TOKEN=
UPSTREAM_USAGE_SYNC_INTERVAL_MS=300000
SMTP_URL=
EMAIL_FROM=
RESEND_API_KEY=
UPSTREAM_SYNC_CONCURRENCY=6
# New customers use the default source or a stable round-robin assignment across enabled sources.
UPSTREAM_ASSIGNMENT_MODE=default
UPSTREAM_SYNC_TIMEOUT_MS=10000
NODE_PROBE_TIMEOUT_MS=2000
NODE_GEO_TIMEOUT_MS=1800
NODE_TEST_CONCURRENCY=24
