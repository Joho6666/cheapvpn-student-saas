# DNS must point this domain to the server before starting Caddy.
DOMAIN=vpn.example.com
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
DATA_DIR=/app/server/data
PUBLIC_BASE_URL=https://vpn.example.com
CORS_ORIGINS=https://vpn.example.com
TRUST_PROXY=true

# Generate long random values. Never reuse local-development passwords.
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
ADMIN_ENCRYPTION_KEY=replace-with-a-random-32-character-or-longer-secret
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-payment-webhook-secret
ALLOW_DEMO_SUBSCRIPTION=false
ALLOW_DEMO_ACCOUNT=false
ALLOW_PRIVATE_UPSTREAM_URLS=false

# Choose manual or webhook. Mock payment is rejected in production.
PAYMENT_MODE=manual
PAYMENT_MANUAL_INSTRUCTIONS=Please contact support after completing payment.
PAYMENT_CHECKOUT_URL_TEMPLATE=

# Configure at least one upstream source here or add it from /#admin after launch.
UPSTREAM_SUBSCRIPTION_URL=
UPSTREAM_USAGE_API_URL=
UPSTREAM_USAGE_API_TOKEN=
UPSTREAM_USAGE_SYNC_INTERVAL_MS=300000
UPSTREAM_ASSIGNMENT_MODE=default

# Required for customer password recovery. SMTP credentials can also be added in /#admin.
SMTP_URL=
EMAIL_FROM=CheapVPN <support@vpn.example.com>
